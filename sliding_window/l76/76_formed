package l76

// https://leetcode.com/problems/minimum-window-substring/
// minWindow returns the shortest substring covering t's character multiplicities,
// or an empty string if none exists. Letters are case-sensitive.
func minWindow(s string, t string) string {
	if len(t) == 0 || len(t) > len(s) {
		return ""
	}

	var need, window [256]int
	required := 0
	for i := 0; i < len(t); i++ {
		c := t[i]
		if need[c] == 0 {
			required++
		}
		need[c]++
	}

	left, formed := 0, 0
	bestStart, bestLen := 0, len(s)+1
	for right := 0; right < len(s); right++ {
		c := s[right]
		window[c]++
		// This character type has just reached its required frequency.
		if need[c] > 0 && window[c] == need[c] {
			formed++
		}

		for formed == required {
			if length := right - left + 1; length < bestLen {
				bestStart, bestLen = left, length
			}

			removed := s[left]
			// Removing a required copy makes this character type insufficient.
			if need[removed] > 0 && window[removed] == need[removed] {
				formed--
			}
			window[removed]--
			left++
		}
	}

	if bestLen > len(s) {
		return ""
	}
	return s[bestStart : bestStart+bestLen]
}
